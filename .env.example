# ============================================================
# gnosis-chat — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================

# --- Supabase ---
# Dashboard: Project Settings > API
# SUPABASE_ANON_KEY      → "Publishable key" (sb_publishable_...)
# SUPABASE_SERVICE_ROLE_KEY → "Secret key" (sb_secret_...) — NEVER expose client-side
# Legacy JWT keys (anon/service_role) still work but will be removed in late 2026
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Qdrant ---
# Use QDRANT_LOCAL_URL para desenvolvimento (Docker) e QDRANT_CLOUD_URL para produção
# O config.py seleciona automaticamente baseado em APP_ENV
QDRANT_LOCAL_URL=http://localhost:6333
QDRANT_CLOUD_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=                          # API key do Qdrant Cloud (vazio para local)
QDRANT_COLLECTION_BOOKS=gnosis_books
QDRANT_COLLECTION_INTERESTS=user_interests

# --- Google AI ---
GOOGLE_API_KEY=your-google-ai-studio-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PREMIUM=price_...

# --- LangSmith ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=gnosis-chat

# --- App ---
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
